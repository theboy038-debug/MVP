# Copy this file to .env and fill in real values.
# .env is loaded automatically at startup (python-dotenv) — never
# commit your actual .env file to version control.

# Required for movie discovery
TMDB_API_KEY=

# Required for AI script generation
GEMINI_API_KEY=

# Optional — only needed if you want viewing-history logged to
# Google Sheets. Leave blank to skip this feature entirely (the app
# works fine without it).
#
# Use ONE of the two credential options below, not both:
GOOGLE_SHEET_ID=

# Option 1 (local dev): path to your downloaded service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Option 2 (Streamlit Cloud, no persistent disk): paste the JSON
# file's contents directly. On Streamlit Cloud, set this via the
# Secrets UI (Settings -> Secrets) instead of in this file.
GOOGLE_SERVICE_ACCOUNT_JSON=
